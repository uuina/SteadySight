<views:ConfigViewBase x:Class="SteadySight.Views.DotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SteadySight.Views">
    <StackPanel>
        <TextBlock Text="动态圆点" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="随视角输入反向漂移的实验性外围参照点。"
                   FontSize="13" Foreground="{StaticResource App.TextSecondary}" Margin="0,0,0,20" />

        <GroupBox Header="模式">
            <StackPanel>
                <TextBlock Text="驱动方式" Margin="0,0,0,6" />
                <ComboBox x:Name="ModeCombo">
                    <ComboBoxItem Content="智能（有移动时显示）" Tag="Auto" />
                    <ComboBoxItem Content="鼠标 + 手柄" Tag="MouseGamepad" />
                    <ComboBoxItem Content="仅鼠标" Tag="Mouse" />
                    <ComboBoxItem Content="关闭" Tag="Off" />
                </ComboBox>
                <TextBlock Text="智能模式仅在检测到视角移动时显示圆点，静止时自动淡出，干扰最小。"
                           FontSize="12" Foreground="{StaticResource App.TextSecondary}" Margin="0,8,0,0" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="参数">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="圆点密度" VerticalAlignment="Center" />
                    <Slider x:Name="DensitySlider" Grid.Column="1" Minimum="10" Maximum="100"
                            TickFrequency="5" />
                    <TextBlock x:Name="DensityValue" Grid.Column="2" Text="55%"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="圆点大小" VerticalAlignment="Center" />
                    <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="1" Maximum="8"
                            TickFrequency="0.5" />
                    <TextBlock x:Name="SizeValue" Grid.Column="2" Text="3.2 px"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="跟随灵敏度" VerticalAlignment="Center" />
                    <Slider x:Name="IntensitySlider" Grid.Column="1" Minimum="10" Maximum="120"
                            TickFrequency="5" />
                    <TextBlock x:Name="IntensityValue" Grid.Column="2" Text="60%"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="高级">
            <StackPanel>
                <CheckBox x:Name="ParallaxCheck" Content="视差缩放（近中心缩小，增强深度感）"
                          />
                <CheckBox x:Name="FadeCheck" Content="静止时自动淡出"
                          />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</views:ConfigViewBase>
