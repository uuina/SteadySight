<views:ConfigViewBase x:Class="SteadySight.Views.AnchorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SteadySight.Views">
    <StackPanel>
        <TextBlock Text="中心锚点" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="屏幕中心的固定参考点，为大脑提供静止参照（rest frame）。"
                   FontSize="13" Foreground="{StaticResource App.TextSecondary}" Margin="0,0,0,20" />

        <GroupBox Header="样式">
            <StackPanel>
                <TextBlock Text="锚点样式" Margin="0,0,0,6" />
                <ComboBox x:Name="StyleCombo">
                    <ComboBoxItem Content="圆点" Tag="Dot" />
                    <ComboBoxItem Content="圆环" Tag="Ring" />
                    <ComboBoxItem Content="圆环加圆点" Tag="CircleDot" />
                    <ComboBoxItem Content="十字" Tag="Cross" />
                    <ComboBoxItem Content="关闭" Tag="Off" />
                </ComboBox>
                <TextBlock Text="游戏中可按 F3 循环切换样式。" FontSize="12"
                           Foreground="{StaticResource App.TextSecondary}" Margin="0,8,0,0" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="外观">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="锚点大小" VerticalAlignment="Center" />
                    <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="6" Maximum="64"
                            TickFrequency="2" />
                    <TextBlock x:Name="SizeValue" Grid.Column="2" Text="16 px"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="透明度" VerticalAlignment="Center" />
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="10" Maximum="100"
                            TickFrequency="5" />
                    <TextBlock x:Name="OpacityValue" Grid.Column="2" Text="55%"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="颜色（十六进制）" VerticalAlignment="Center" />
                    <TextBox x:Name="ColorBox" Grid.Column="1" />
                    <Button x:Name="ResetColor" Grid.Column="2" Content="默认" Margin="8,0,0,0"
                            />
                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</views:ConfigViewBase>
