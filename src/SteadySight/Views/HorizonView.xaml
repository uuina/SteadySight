<views:ConfigViewBase x:Class="SteadySight.Views.HorizonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SteadySight.Views">
    <StackPanel>
        <TextBlock Text="水平参考线" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="一条水平参考线，帮助维持空间定向，适合驾驶与飞行类游戏。"
                   FontSize="13" Foreground="{StaticResource App.TextSecondary}" Margin="0,0,0,20" />

        <GroupBox Header="样式">
            <StackPanel>
                <TextBlock Text="参考线样式" Margin="0,0,0,6" />
                <ComboBox x:Name="StyleCombo">
                    <ComboBoxItem Content="实线" Tag="Line" />
                    <ComboBoxItem Content="虚线" Tag="LineTick" />
                    <ComboBoxItem Content="关闭" Tag="Off" />
                </ComboBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="位置与透明度">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="透明度" VerticalAlignment="Center" />
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="5" Maximum="60"
                            TickFrequency="5" />
                    <TextBlock x:Name="OpacityValue" Grid.Column="2" Text="22%"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="垂直偏移" VerticalAlignment="Center" />
                    <Slider x:Name="OffsetSlider" Grid.Column="1" Minimum="-25" Maximum="25"
                            TickFrequency="1" />
                    <TextBlock x:Name="OffsetValue" Grid.Column="2" Text="0%"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="正值为向下偏移，负值为向上偏移。"
                           FontSize="12" Foreground="{StaticResource App.TextSecondary}" Margin="0,12,0,0" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</views:ConfigViewBase>
