<views:ConfigViewBase x:Class="SteadySight.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SteadySight.Views">
    <StackPanel>
        <TextBlock Text="欢迎使用 SteadySight" FontSize="26" FontWeight="SemiBold"
                   Margin="0,0,0,6" />
        <TextBlock x:Name="SubText" Text="基于视觉稳定锚点与柔和周边提示的防晕助手"
                   FontSize="13" Foreground="{StaticResource App.TextSecondary}"
                   Margin="0,0,0,20" />

        <Border Background="{StaticResource App.Surface}" CornerRadius="8"
                Padding="20" Margin="0,0,0,16"
                BorderBrush="{StaticResource App.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="叠加层状态" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="运行中" FontSize="13"
                               Foreground="{StaticResource App.Success}" Margin="0,6,0,0" />
                    <TextBlock x:Name="PresetText" Text="预设：标准" FontSize="13"
                               Foreground="{StaticResource App.TextSecondary}" Margin="0,4,0,0" />
                    <TextBlock x:Name="TargetText" Text="目标：所有显示器" FontSize="13"
                               Foreground="{StaticResource App.TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="ToggleBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Content="关闭叠加层" MinWidth="120" />
            </Grid>
        </Border>

        <Border Background="{StaticResource App.Surface}" CornerRadius="8"
                Padding="20" Margin="0,0,0,16"
                BorderBrush="{StaticResource App.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="游戏内快捷操作" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="F1  总开关 · F2  边缘样式 · F3  中心锚点" FontSize="13"
                           Foreground="{StaticResource App.TextSecondary}" Margin="0,2" />
                <TextBlock Text="F4  动态圆点 · Ctrl+F5  循环预设 · Ctrl+F6  休息提示" FontSize="13"
                           Foreground="{StaticResource App.TextSecondary}" Margin="0,2" />
                <TextBlock Text="提示：请将游戏设为无边框或窗口模式，叠加层效果最佳。" FontSize="12"
                           Foreground="{StaticResource App.TextSecondary}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Border Background="{StaticResource App.Surface}" CornerRadius="8"
                Padding="20"
                BorderBrush="{StaticResource App.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="如何减少干扰" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="初始采用柔和设置，若仍感不适逐步增强边缘遮罩；若画面遮挡明显可降低透明度和宽度。" 
                           TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource App.TextSecondary}" />
            </StackPanel>
        </Border>
    </StackPanel>
</views:ConfigViewBase>
