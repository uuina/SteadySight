<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主色：柔和青绿 + 中性灰，低刺激、适合长时间使用 -->
    <SolidColorBrush x:Key="App.Background" Color="#F5F7FA" />
    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.NavBackground" Color="#EDF1F5" />
    <SolidColorBrush x:Key="App.Accent" Color="#12B886" />
    <SolidColorBrush x:Key="App.AccentDark" Color="#0E9D75" />
    <SolidColorBrush x:Key="App.TextPrimary" Color="#1F2933" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#52606D" />
    <SolidColorBrush x:Key="App.Border" Color="#D9E2EA" />
    <SolidColorBrush x:Key="App.Danger" Color="#E03131" />
    <SolidColorBrush x:Key="App.Success" Color="#12B886" />

    <SolidColorBrush x:Key="Nav.Item.Hover" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Nav.Item.Active" Color="#D3F9E8" />
    <SolidColorBrush x:Key="Nav.Item.ActiveText" Color="#0E9D75" />

    <FontFamily x:Key="App.Font">Microsoft YaHei UI, Segoe UI</FontFamily>
</ResourceDictionary>
